# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Sanity (public — exposed in the browser bundle) ---
# Use the SAME project id + dataset as studio/.env.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: pin the Sanity API version. Defaults to 2026-02-01 if unset.
# NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01

# --- Public site URL (used for absolute links / metadata) ---
# Local: http://localhost:3000   Vercel: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity write token (server only — NEVER prefix with NEXT_PUBLIC_) ---
# Editor role. Used by /api/contact and /api/apply to write submission documents.
SANITY_API_WRITE_TOKEN=

# --- Email (Resend) — optional; the forms still save without it ---
# IMPORTANT: lib/email.ts ships with `from: onboarding@resend.dev` (Resend's
# sandbox sender). It works with no DNS setup but lands in spam at most inboxes.
# Before production: verify your domain in resend.com and change the `from`
# address in lib/email.ts to something@your-domain.
RESEND_API_KEY=
OWNER_EMAIL=
